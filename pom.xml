<?xml version="1.0" encoding="UTF-8"?>
<!--
    ╔═══════════════════════════════════════════════════════════════╗
    ║               POM.XML DO CATÁLOGO MUSICAL (PILOTO)            ║
    ║                                                               ║
    ║  Mesmíssima estrutura do pom.xml da Aula 02. Se tiver dúvida  ║
    ║  sobre o que é cada tag, abra o pom.xml comentado do          ║
    ║  quiz-battle-comentado que lá está bem detalhado.             ║
    ║                                                               ║
    ║  As mudanças aqui vs a Aula 02:                               ║
    ║      - artifactId : catalogo-musical-piloto                   ║
    ║      - mainClass  : br.cesul.catalogomusical.ui.MainApp       ║
    ║                                                               ║
    ║  Tudo o resto é IDÊNTICO porque usamos o mesmo stack:         ║
    ║  Java 17, JavaFX 21, Mongo Driver 4.11.                       ║
    ╚═══════════════════════════════════════════════════════════════╝
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Coordenadas que identificam o projeto: grupo, nome, versão -->
    <groupId>br.cesul</groupId>
    <artifactId>catalogo-musical-piloto</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
        Propriedades reutilizáveis (variáveis do pom).
        Mudar a versão aqui afeta todas as referências abaixo.
    -->
    <properties>
        <java.version>17</java.version>
        <javafx.version>21</javafx.version>
        <mongo.version>4.11.0</mongo.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- Controles JavaFX: Button, Label, TableView, TabPane, ListView... -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Camada gráfica: Stage, Scene, Canvas, animações -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!--
            Driver síncrono do MongoDB.
            Nos dá as classes MongoClient, MongoCollection, Document,
            Filters, Updates. "sync" = chamadas bloqueantes.
        -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>${mongo.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!--
                Plugin do JavaFX: adiciona o comando  mvn javafx:run
                que cuida do module path e sobe a aplicação sem que
                vc precise ajustar flags do JVM no IntelliJ.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>br.cesul.catalogomusical.ui.MainApp</mainClass>
                </configuration>
            </plugin>

            <!--
                Plugin do compilador. Fixa source/target em 17 para
                todos os alunos gerarem bytecode idêntico e compatível
                com JDK 17+.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

        </plugins>
    </build>
</project>
